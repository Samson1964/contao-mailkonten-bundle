{
    "name": "schachbulle/contao-mailkonten-bundle",
    "type": "contao-bundle",
    "description": "Verwaltet E-Mail-Konten und ihre Zuordnung zu Funktionen und Personen.",
    "keywords": [
        "contao",
        "email",
        "konten",
        "verwaltung"
    ],
    "homepage": "https://github.com/Samson1964/contao-mailkonten-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "menatwork/contao-multicolumnwizard-bundle": "^3.4",
        "symfony/mailer": "^5.4 || ^6.0 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "suggest": {
        "ext-imap": "Wird für den Kontocheck (Anzahl der E-Mails und Speicherbelegung) benötigt. Seit PHP 8.4 nur noch über PECL verfügbar."
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoMailkontenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoMailkontenBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoMailkontenBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-mailkonten-bundle/issues",
        "source": "https://github.com/Samson1964/contao-mailkonten-bundle"
    }
}
